{
  "name": "unitrack",
  "version": "1.0.0",
  "private": true,
  "description": "UniTrack academic management application for University of Ibadan students",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node --check server.js && node --check app.js",
    "test:smoke": "node smoke-test.mjs",
    "test:a11y": "playwright test tests/a11y.spec.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:backup": "powershell -ExecutionPolicy Bypass -File scripts/backup.ps1"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jose": "^6.0.10",
    "pg": "^8.16.3",
    "zod": "^3.25.67"
  }
}
