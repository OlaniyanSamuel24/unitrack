{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "runtime": "nodejs20.x",
      "includeFiles": "{index.html,styles.css,app.js,client-integration.js,privacy.html,lib/**,db/migrations/**,public/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
